# Optional override. The application defaults to data/meme_vault.db.
DATABASE_URL=sqlite:///data/meme_vault.db

# v0.3 environment fallback. The v0.3.1 web UI can manage encrypted providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30

# Optional Fernet key for encrypted web settings. When omitted, Meme Vault
# creates the ignored local file data/.ai_settings.key automatically.
AI_SETTINGS_ENCRYPTION_KEY=
