{
  "color": {
    "primitive": {
      "neutral": {
        "950": "#090b10", "900": "#11141b", "850": "#171b24",
        "800": "#1d2330", "750": "#242b39", "600": "#414a5d",
        "400": "#8f98aa", "200": "#c7cdd8", "50": "#f7f8fb"
      },
      "accent": { "500": "#e6ff4a", "600": "#b9d126", "ink": "#111500" },
      "danger": { "500": "#ff6174" },
      "success": { "500": "#9ee6bd" },
      "warning": { "500": "#ffc76d" }
    },
    "semantic": {
      "text": {
        "primary": "{color.primitive.neutral.50}",
        "secondary": "{color.primitive.neutral.200}",
        "muted": "{color.primitive.neutral.400}",
        "disabled": "rgb(247 248 251 / 42%)"
      },
      "surface": {
        "page": "{color.primitive.neutral.950}",
        "card": "{color.primitive.neutral.900}",
        "panel": "{color.primitive.neutral.850}",
        "elevated": "{color.primitive.neutral.800}",
        "hover": "{color.primitive.neutral.800}",
        "active": "{color.primitive.neutral.750}"
      },
      "border": {
        "soft": "rgb(255 255 255 / 9%)",
        "default": "{color.semantic.border.soft}",
        "strong": "{color.primitive.neutral.600}"
      },
      "accent": {
        "primary": "{color.primitive.accent.500}",
        "hover": "{color.primitive.accent.500}",
        "active": "{color.primitive.accent.600}",
        "ink": "{color.primitive.accent.ink}"
      },
      "status": {
        "danger": "{color.primitive.danger.500}",
        "success": "{color.primitive.success.500}",
        "warning": "{color.primitive.warning.500}"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "base": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Microsoft YaHei\", sans-serif"
    },
    "fontSize": {
      "xs": "0.6875rem", "sm": "0.75rem", "md": "0.875rem",
      "lg": "clamp(1.375rem, 2.2vw, 1.875rem)",
      "xl": "clamp(1.625rem, 3vw, 2.375rem)"
    },
    "fontWeight": { "normal": 450, "medium": 600, "semibold": 600, "bold": 750 },
    "lineHeight": { "tight": 1.35, "normal": 1.5, "relaxed": 1.7 }
  },
  "spacing": {
    "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem",
    "5": "1.5rem", "6": "2rem", "7": "3rem"
  },
  "radius": {
    "xs": "0.375rem", "sm": "0.5rem", "md": "0.75rem",
    "lg": "1rem", "xl": "1.25rem", "pill": "999px"
  },
  "border": { "width": "1px" },
  "shadow": {
    "sm": "0 8px 24px rgb(0 0 0 / 14%)",
    "md": "0 20px 60px rgb(0 0 0 / 24%)",
    "lg": "0 34px 100px rgb(0 0 0 / 55%)"
  },
  "motion": {
    "duration": { "fast": "120ms", "normal": "180ms", "slow": "280ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.72, 0.25, 1)",
      "emphasized": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "focus": {
    "ringColor": "{color.primitive.accent.600}",
    "ringWidth": "2px",
    "ringOffset": "2px",
    "ringShadow": "0 0 0 var(--focus-ring-width) var(--focus-ring-color)"
  },
  "control": { "height": { "sm": "2rem", "md": "2.625rem", "lg": "2.75rem" } }
}
